universe        = vanilla
executable      = run_from_scan_sr2.sh
transfer_input_files = sr2_fom_scan.py
arguments       = $(MASS) $(FLAV) $(ERA)  $(NBIN)
log             = logs/scan_sr2_$(MASS)_$(FLAV)_$(ERA)_$(NBIN).log
output          = logs/scan_sr2_$(MASS)_$(FLAV)_$(ERA)_$(NBIN).out
error           = logs/scan_sr2_$(MASS)_$(FLAV)_$(ERA)_$(NBIN).err
request_cpus    = 1
request_memory  = 4000
getenv          = True
+JobFlavour     = "longlunch"
concurrency_limits = n600.jalmond


queue MASS, FLAV, ERA, NBIN from fom_scan_list.txt